# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. Never put credentials here — auth uses
# Application Default Credentials (gcloud auth application-default login).

GCS_BUCKET_NAME=cropgen-maharashtra-boundary
GCS_MH1_PATH=boundary-data/mh1.geojson
GCS_MH2_PATH=boundary-data/mh2.geojson

# Optional: not needed to read objects
# GOOGLE_CLOUD_PROJECT=
