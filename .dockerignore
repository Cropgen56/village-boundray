# Only app/, run.py and requirements.txt are needed in the image.

# Version control / Docker files
.git/
.gitignore
.dockerignore
Dockerfile
docker-compose.yml

# Python caches / virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Datasets are downloaded from Cloud Storage at startup — never bake them in
data/
*.geojson

# Local env / credentials
.env
.env.*
*credentials*.json
*service-account*.json

# Dev-only files
scripts/
requirements-dev.txt
README.md

# Tooling caches / IDE / OS
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
.DS_Store
